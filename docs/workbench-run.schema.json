{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-theory-workbench.local/schemas/workbench-run-v1.json",
  "title": "Axiovela normalized experiment run",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "source", "metrics", "artifacts"],
  "properties": {
    "schemaVersion": {"const": "workbench.run/v1"},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "experiment": {"type": "string", "description": "Plain-language experiment group, recorded before computation."},
    "summary": {"type": "string"},
    "status": {"enum": ["queued", "running", "complete", "failed", "canceled"]},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "completedAt": {"type": ["string", "null"], "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["adapter"],
      "properties": {
        "adapter": {"enum": ["native", "mlflow", "wandb"]},
        "externalId": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "parameters": {"type": "object"},
    "metrics": {"type": "object"},
    "artifacts": {"type": "array", "items": {"type": ["string", "object"]}},
    "tags": {"type": "object"},
    "environment": {"type": "object"},
    "logs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
